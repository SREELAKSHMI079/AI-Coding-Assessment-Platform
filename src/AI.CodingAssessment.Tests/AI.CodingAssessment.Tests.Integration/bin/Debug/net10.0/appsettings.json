{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AICodingAssessmentDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_FOR_JWT_SIGNING_PHRASE",
    "Issuer": "AICodingAssessmentAPI",
    "Audience": "AICodingAssessmentClient",
    "ExpirationInMinutes": 60
  },
  "AIService": {
    "Provider": "ConfigurableExternalAIProvider",
    "ApiUrl": "https://api.external-ai-provider.com/v1",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "CodeExecutionService": {
    "ExecutionEngineUrl": "http://localhost:5100/execute",
    "DefaultMemoryLimitMb": 256,
    "DefaultTimeLimitMs": 2000
  }
}
